{
  "name": "admin-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deadcode": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run test:onyx && npm run schema:validate && npm run lint && npm run typecheck && npm run format:check && npm run deadcode && npm run test && npm run build",
    "check:all": "npm run check && npm run test:e2e",
    "prepare": "husky",
    "template:init": "node --experimental-strip-types scripts/init-template.ts",
    "template:smoke": "node --experimental-strip-types scripts/smoke-template.ts",
    "onyx:tasks": "node --conditions=react-server --experimental-strip-types scripts/tasks.ts",
    "schema:validate": "node --experimental-strip-types scripts/schema.ts validate",
    "schema:diff": "node --experimental-strip-types scripts/schema.ts diff",
    "schema:publish": "node --experimental-strip-types scripts/schema.ts publish",
    "test:onyx": "node --conditions=react-server --experimental-strip-types --test scripts/onyx.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@onyx.dev/onyx-database": "2.8.4",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nuqs": "^2.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "knip": "6.27.0",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
